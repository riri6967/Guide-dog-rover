      <link name="link">
        <collision name="collision"><geometry><box><size>8.737 0.200 2.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.737 0.200 2.000</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
