<?xml version="1.0"?>
<sdf version="1.9">

  <model name="assistive_rover">

    <!-- ========================================================= -->
    <!-- MAIN CHASSIS                                              -->
    <!-- ========================================================= -->

    <link name="base_link">

      <pose>0 0 0.28 0 0 0</pose>

      <inertial>
        <mass>7.0</mass>
        <inertia>
          <ixx>0.35</ixx>
          <iyy>0.45</iyy>
          <izz>0.60</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.90 0.60 0.22</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">

        <geometry>
          <box>
            <size>0.90 0.60 0.22</size>
          </box>
        </geometry>

        <!-- Blue body -->
        <material>
          <ambient>0.03 0.20 0.80 1</ambient>
          <diffuse>0.03 0.20 0.80 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>

      </visual>


      <!-- ===================================================== -->
      <!-- SENSOR MAST                                            -->
      <!-- ===================================================== -->

      <visual name="sensor_mast">

        <pose>0 0 0.32 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.64</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>

      </visual>


      <!-- ===================================================== -->
      <!-- CONTACT / COLLISION GROUND TRUTH                        -->
      <!-- ===================================================== -->

      <sensor name="rover_contact" type="contact">

        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>

        <topic>/rover_contacts</topic>

        <contact>
          <collision>base_collision</collision>
        </contact>

      </sensor>


      <!-- ===================================================== -->
      <!-- LIDAR                                                   -->
      <!-- ===================================================== -->

      <sensor name="lidar" type="gpu_lidar">

        <pose>0 0 0.68 0 0 0</pose>

        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>

        <topic>scan</topic>

        <lidar>

          <scan>

            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>

          </scan>

          <range>
            <min>0.12</min>
            <max>15.0</max>
            <resolution>0.01</resolution>
          </range>

        </lidar>

      </sensor>


      <!-- ===================================================== -->
      <!-- RGB-D CAMERA                                            -->
      <!-- ===================================================== -->

      <sensor name="rgbd_camera" type="rgbd_camera">

        <pose>0.32 0 0.58 0 0 0</pose>

        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>

        <topic>rgbd_camera</topic>

        <camera>

          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
          </image>

          <clip>
            <near>0.10</near>
            <far>10.0</far>
          </clip>

        </camera>

      </sensor>


      <!-- ===================================================== -->
      <!-- IMU                                                     -->
      <!-- ===================================================== -->

      <sensor name="imu" type="imu">

        <pose>0 0 0.40 0 0 0</pose>

        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>

        <topic>imu</topic>

      </sensor>


      <!-- ===================================================== -->
      <!-- FRONT CAMERA HOUSING                                    -->
      <!-- ===================================================== -->

      <visual name="camera_mount">

        <pose>0.32 0 0.58 0 0 0</pose>

        <geometry>
          <box>
            <size>0.16 0.12 0.08</size>
          </box>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>

      </visual>

    </link>


    <!-- ========================================================= -->
    <!-- FRONT LEFT WHEEL                                          -->
    <!-- ========================================================= -->

    <link name="front_left_wheel">

      <pose>0.30 0.34 0.12 1.5708 0 0</pose>

      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.012</iyy>
          <izz>0.012</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>

      </visual>

    </link>


    <!-- ========================================================= -->
    <!-- REAR LEFT WHEEL                                           -->
    <!-- ========================================================= -->

    <link name="rear_left_wheel">

      <pose>-0.30 0.34 0.12 1.5708 0 0</pose>

      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.012</iyy>
          <izz>0.012</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>

      </visual>

    </link>


    <!-- ========================================================= -->
    <!-- FRONT RIGHT WHEEL                                         -->
    <!-- ========================================================= -->

    <link name="front_right_wheel">

      <pose>0.30 -0.34 0.12 1.5708 0 0</pose>

      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.012</iyy>
          <izz>0.012</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>

      </visual>

    </link>


    <!-- ========================================================= -->
    <!-- REAR RIGHT WHEEL                                          -->
    <!-- ========================================================= -->

    <link name="rear_right_wheel">

      <pose>-0.30 -0.34 0.12 1.5708 0 0</pose>

      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.012</iyy>
          <izz>0.012</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>

      </visual>

    </link>


    <!-- ========================================================= -->
    <!-- WHEEL JOINTS                                               -->
    <!-- ========================================================= -->

    <joint name="front_left_wheel_joint" type="revolute">
      <pose relative_to="front_left_wheel">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <pose relative_to="rear_left_wheel">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <pose relative_to="front_right_wheel">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <pose relative_to="rear_right_wheel">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>


    <!-- ========================================================= -->
    <!-- DIFFERENTIAL DRIVE                                         -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>1.46</wheel_separation>
      <wheel_radius>0.12</wheel_radius>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>

    </plugin>

  </model>

</sdf>
