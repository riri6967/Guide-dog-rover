<?xml version="1.0"?>
<sdf version="1.9">

  <model name="door">

    <static>true</static>

    <!-- Door panel -->
    <link name="door_link">

      <collision name="door_collision">
        <pose>0 0 1.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 1.8 2.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="door_visual">
        <pose>0 0 1.1 0 0 0</pose>

        <geometry>
          <box>
            <size>0.08 1.8 2.2</size>
          </box>
        </geometry>

        <material>
          <ambient>0.45 0.22 0.08 1</ambient>
          <diffuse>0.45 0.22 0.08 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- Door handle -->
      <visual name="handle">
        <pose>0 0.62 1.05 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.85 0.70 0.20 1</ambient>
          <diffuse>0.85 0.70 0.20 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>
