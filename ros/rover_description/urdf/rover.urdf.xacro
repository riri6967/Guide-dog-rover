<?xml version="1.0"?>
<!--
  Guide Dog Rover - robot description.

  Frames (REP-103: +X forward, +Y left, +Z up):

    base_footprint            on the ground, directly under base_link
    `- base_link              centre of the four axles, at axle height
        +- chassis            the tub (visual/collision only, fixed)
        +- front_left_wheel  \
        +- front_right_wheel | continuous joints, spin about +Y
        +- rear_left_wheel   |
        +- rear_right_wheel  /
        +- laser              RPLIDAR A1M8 scan centre
        +- imu_link           MPU6050 chip
        `- camera_link        Pi Camera lens, front face
            `- camera_link_optical   (+Z forward, +X right, +Y down)

  Every dimension below is measured from the SolidWorks assembly
  (CAD Files/Old Prototype Design/Assem1.STEP), which is the robot as built -
  except the wheels: the CAD has 119.6 mm tyres, the robot has 65 mm wheels.
  The visual meshes in meshes/ come from the same file through
  tools/step_to_meshes.py; if the CAD changes, re-run that AND update the
  numbers here. The two must agree.

  The electronics (Pi, ESP32, L298N, battery) are not modelled - they are part
  of the chassis. All lengths in metres, angles in radians.
-->
<robot name="guide_dog_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- Drivetrain                                                          -->
  <!-- ================================================================== -->
  <!-- The wheels actually fitted are 65 mm (as in the firmware), not the
       119.6 mm tyre in the CAD. Only the size changes: the axles are fixed to
       the body, so every sensor pose below stays as measured. The CAD wheel
       mesh is shrunk radially to match; its tread width is left as is. -->
  <xacro:property name="wheel_radius"   value="0.0325"/>  <!-- 65 mm wheel -->
  <xacro:property name="wheel_width"    value="0.041"/>
  <xacro:property name="cad_wheel_radius" value="0.0598"/>  <!-- size of meshes/*_wheel.stl -->
  <xacro:property name="track_width"    value="0.2146"/>  <!-- L wheel centre to R wheel centre -->
  <xacro:property name="wheelbase"      value="0.1473"/>  <!-- front axle to rear axle -->

  <!-- ================================================================== -->
  <!-- Chassis tub: outer bounding box, relative to base_link              -->
  <!-- ================================================================== -->
  <xacro:property name="chassis_length" value="0.2743"/>
  <xacro:property name="chassis_width"  value="0.2083"/>
  <xacro:property name="chassis_height" value="0.1296"/>
  <xacro:property name="chassis_bottom" value="-0.0153"/>  <!-- underside is 15 mm below the axles -->

  <!-- ================================================================== -->
  <!-- Sensors: pose relative to base_link (x forward, y left, z up)       -->
  <!-- ================================================================== -->

  <!-- RPLIDAR A1M8. Origin is the spin axis at the height of the laser
       emitter/receiver, i.e. the scan plane - not the bottom of the unit.
       laser_yaw = pi because the driver's 0 deg points toward the motor
       (the A1's narrow tail), and the tail faces the rear. Verify with the
       box test: an object straight ahead must appear at +X in RViz. -->
  <xacro:property name="laser_x"   value="0.08805"/>
  <xacro:property name="laser_y"   value="-0.0011"/>
  <xacro:property name="laser_z"   value="0.1730"/>
  <xacro:property name="laser_yaw" value="${pi}"/>

  <!-- MPU6050 on its GY-521 board, flat on the tub floor, pin header toward
       the rear. On a GY-521 the printed +Y arrow points away from the pins and
       +X runs along them, so the board's X faces the robot's right:
       yaw = -pi/2. Verify with the tilt tests before trusting it. -->
  <xacro:property name="imu_x"     value="-0.00455"/>
  <xacro:property name="imu_y"     value="-0.0080"/>
  <xacro:property name="imu_z"     value="-0.0097"/>
  <xacro:property name="imu_roll"  value="0.0"/>
  <xacro:property name="imu_pitch" value="0.0"/>
  <xacro:property name="imu_yaw"   value="${-pi/2}"/>

  <!-- Pi Camera, centre of the lens front, on the front face of the tub.
       The CAD uses a Camera Module v2.1 model; the v3 actually fitted has the
       same 25 x 24 mm board, so any lens offset is a few millimetres. -->
  <xacro:property name="camera_x"     value="0.13975"/>
  <xacro:property name="camera_y"     value="0.0"/>
  <xacro:property name="camera_z"     value="0.0469"/>
  <xacro:property name="camera_pitch" value="0.0"/>     <!-- positive = tilted DOWN -->

  <!-- Masses, only used by simulators. -->
  <xacro:property name="chassis_mass" value="2.0"/>
  <xacro:property name="wheel_mass"   value="0.15"/>

  <!-- ================================================================== -->
  <!-- Derived - do not edit                                               -->
  <!-- ================================================================== -->
  <xacro:property name="half_track" value="${track_width / 2}"/>
  <xacro:property name="half_base"  value="${wheelbase / 2}"/>
  <xacro:property name="mesh_dir"   value="package://rover_description/meshes"/>

  <!-- ================================================================== -->
  <!-- Materials                                                           -->
  <!-- ================================================================== -->
  <material name="grey">  <color rgba="0.75 0.75 0.75 1"/></material>
  <material name="black"> <color rgba="0.10 0.10 0.10 1"/></material>
  <material name="dark">  <color rgba="0.20 0.20 0.20 1"/></material>
  <material name="green"> <color rgba="0.10 0.45 0.20 1"/></material>
  <material name="blue">  <color rgba="0.20 0.30 0.80 1"/></material>

  <!-- ================================================================== -->
  <!-- Inertia helpers                                                     -->
  <!-- ================================================================== -->
  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder with its axis along the link's Y (how the wheels are built). -->
  <xacro:macro name="wheel_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*r*r/2}"          iyz="0"
               izz="${m*(3*r*r+h*h)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- ================================================================== -->
  <!-- Base                                                                -->
  <!-- ================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- The chassis link shares base_link's origin so its mesh drops straight
       in; the collision box is offset to where the tub actually is. -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry><mesh filename="${mesh_dir}/chassis.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_bottom + chassis_height / 2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_bottom + chassis_height / 2}" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <!-- ================================================================== -->
  <!-- Wheels                                                              -->
  <!--                                                                    -->
  <!-- Skid-steer: both wheels on a side are driven together and share one  -->
  <!-- encoder, so kinematically this is a differential drive with         -->
  <!-- track_width as the separation. Four are modelled because four touch  -->
  <!-- the ground (footprint, collision, simulation).                      -->
  <!-- ================================================================== -->
  <xacro:macro name="wheel" params="prefix x y">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <!-- Mesh axle is along Y: scale X and Z (the diameter), keep Y (the width). -->
        <geometry><mesh filename="${mesh_dir}/${prefix}_wheel.stl"
                        scale="${wheel_radius / cad_wheel_radius} 1 ${wheel_radius / cad_wheel_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x="${ half_base}" y="${ half_track}"/>
  <xacro:wheel prefix="front_right" x="${ half_base}" y="${-half_track}"/>
  <xacro:wheel prefix="rear_left"   x="${-half_base}" y="${ half_track}"/>
  <xacro:wheel prefix="rear_right"  x="${-half_base}" y="${-half_track}"/>

  <!-- ================================================================== -->
  <!-- LiDAR                                                               -->
  <!-- ================================================================== -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 ${laser_yaw}"/>
  </joint>

  <link name="laser">
    <visual>
      <geometry><mesh filename="${mesh_dir}/lidar.stl"/></geometry>
      <material name="dark"/>
    </visual>
    <!-- Unit plus its mount: 62 mm tall, top 9 mm above the scan plane. -->
    <collision>
      <origin xyz="0 0 -0.0221" rpy="0 0 0"/>
      <geometry><cylinder radius="0.036" length="0.0626"/></geometry>
    </collision>
  </link>

  <!-- ================================================================== -->
  <!-- IMU                                                                 -->
  <!-- ================================================================== -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/imu.stl"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- ================================================================== -->
  <!-- Camera                                                              -->
  <!-- ================================================================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/camera.stl"/></geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- Image pipelines (OpenCV, image_proc, AprilTag, ...) expect the optical
       convention. Set the camera driver's frame_id to this one. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_link_optical"/>

</robot>
