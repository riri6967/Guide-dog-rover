<?xml version="1.0"?>
<!-- GENERATED by tools/handle_to_urdf.py from the handle CAD - do not edit by hand.
     Haptic handle: hinge bracket on the rover, the rod and grip on a pivot, and the four
     vibration modules. Included from rover.urdf.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="haptic_handle" params="joint_type:=revolute">
    <material name="handle_grey"><color rgba="0.55 0.57 0.61 1"/></material>
    <material name="handle_grip"><color rgba="0.85 0.81 0.73 1"/></material>
    <material name="aluminium"> <color rgba="0.75 0.76 0.78 1"/></material>
    <material name="vib_board"> <color rgba="0.08 0.08 0.09 1"/></material>

    <!-- Hinge bracket, bolted to the rover's rear top. Frame on the pivot axis. -->
    <joint name="handle_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="handle_mount"/>
      <origin xyz="-0.1172 0 0.1393" rpy="0 0 0"/>
    </joint>
    <link name="handle_mount">
      <visual>
        <geometry><mesh filename="${mesh_dir}/handle_mount.stl" scale="${mm}"/></geometry>
        <material name="dark"/>
      </visual>
    </link>

    <!-- The M6 pivot. 0 = design pose (rod 50 deg above horizontal); positive = rod steeper.
         The stop bolts limit it to 35-75 deg. Pass joint_type:=fixed for a simulator that
         should not let the handle fall over. -->
    <joint name="handle_joint" type="${joint_type}">
      <parent link="handle_mount"/>
      <child  link="handle"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.2618" upper="0.4363" effort="20" velocity="2"/>
      <dynamics damping="0.5" friction="0.2"/>
    </joint>

    <link name="handle">
      <visual>
        <geometry><mesh filename="${mesh_dir}/handle_rod.stl" scale="${mm}"/></geometry>
        <material name="aluminium"/>
      </visual>
      <visual>
        <geometry><mesh filename="${mesh_dir}/handle_frame.stl" scale="${mm}"/></geometry>
        <material name="handle_grey"/>
      </visual>
      <visual>
        <geometry><mesh filename="${mesh_dir}/handle_grip.stl" scale="${mm}"/></geometry>
        <material name="handle_grip"/>
      </visual>
      <!-- The rod is what the LiDAR sees behind the robot: keep this collision for self-filtering. -->
      <collision>
        <origin xyz="-0.19798 0 0.23594" rpy="0 2.44346 0"/>
        <geometry><cylinder radius="0.008" length="0.6300"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.40158 0 0.52389" rpy="0 0 0"/>
        <geometry><box size="0.064458 0.12707 0.16091"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.33335 0 0.44043" rpy="0 0 0"/>
        <mass value="0.251"/>
        <inertia ixx="7.148e-03" ixy="0.000e+00" ixz="4.948e-03" iyy="1.066e-02" iyz="0.000e+00" izz="3.527e-03"/>
      </inertial>
    </link>

    <!-- front vibration module (driven by PIN_HAP_FRONT in rover_microros/pins.h). Origin: motor face on the grip's 1 mm skin; +X = out through the skin. -->
    <joint name="haptic_front_joint" type="fixed">
      <parent link="handle"/>
      <child  link="haptic_front"/>
      <origin xyz="-0.38731 0 0.57634" rpy="0 -0 0"/>
    </joint>
    <link name="haptic_front">
      <visual>
        <geometry><mesh filename="${mesh_dir}/vibration_module.stl" scale="${mm}"/></geometry>
        <material name="vib_board"/>
      </visual>
    </link>

    <!-- back vibration module (driven by PIN_HAP_BACK in rover_microros/pins.h). Origin: motor face on the grip's 1 mm skin; +X = out through the skin. -->
    <joint name="haptic_back_joint" type="fixed">
      <parent link="handle"/>
      <child  link="haptic_back"/>
      <origin xyz="-0.42121 0 0.57584" rpy="0 -0 3.1416"/>
    </joint>
    <link name="haptic_back">
      <visual>
        <geometry><mesh filename="${mesh_dir}/vibration_module.stl" scale="${mm}"/></geometry>
        <material name="vib_board"/>
      </visual>
    </link>

    <!-- left vibration module (driven by PIN_HAP_LEFT in rover_microros/pins.h). Origin: motor face on the grip's 1 mm skin; +X = out through the skin. -->
    <joint name="haptic_left_joint" type="fixed">
      <parent link="handle"/>
      <child  link="haptic_left"/>
      <origin xyz="-0.40431 0.059 0.57734" rpy="0 -0 1.5708"/>
    </joint>
    <link name="haptic_left">
      <visual>
        <geometry><mesh filename="${mesh_dir}/vibration_module.stl" scale="${mm}"/></geometry>
        <material name="vib_board"/>
      </visual>
    </link>

    <!-- right vibration module (driven by PIN_HAP_RIGHT in rover_microros/pins.h). Origin: motor face on the grip's 1 mm skin; +X = out through the skin. -->
    <joint name="haptic_right_joint" type="fixed">
      <parent link="handle"/>
      <child  link="haptic_right"/>
      <origin xyz="-0.40431 -0.059 0.57734" rpy="0 -0 -1.5708"/>
    </joint>
    <link name="haptic_right">
      <visual>
        <geometry><mesh filename="${mesh_dir}/vibration_module.stl" scale="${mm}"/></geometry>
        <material name="vib_board"/>
      </visual>
    </link>
  </xacro:macro>
</robot>
