# Arduino / arduino-cli build output
build/
*.elf
*.bin
*.map
*.hex

# Packaged handoff archives — rebuild rather than version them
*.zip
# ...except the trained SAC model kept with the simulation results
!sim/assistive_robot/training/runs/*/model.zip

# OpenSCAD exports
*.stl
# ...but the URDF meshes are source, not exports - the Pi needs them
!ros/rover_description/meshes/*.stl
*.3mf
*.gcode

# Editor and OS noise
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
