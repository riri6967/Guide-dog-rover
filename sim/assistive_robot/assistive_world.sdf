<?xml version="1.0"?>
<sdf version="1.9">

  <world name="assistive_world">

    <!-- ========================================================= -->
    <!-- WORLD SYSTEMS                                             -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>


    <!-- ========================================================= -->
    <!-- PHYSICS                                                   -->
    <!-- ========================================================= -->

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.81</gravity>


    <!-- ========================================================= -->
    <!-- OUTDOOR GROUND                                            -->
    <!-- ========================================================= -->

    <model name="ground">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- SUN                                                        -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 15 0 0 0</pose>

      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.30 0.30 0.30 1</specular>

      <direction>-0.4 0.3 -1</direction>

    </light>


    <!-- ========================================================= -->
    <!-- HOUSE FLOOR                                                -->
    <!-- ========================================================= -->

    <model name="house_floor">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>12 8 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>12 8 0.08</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.43 0.30 1</ambient>
            <diffuse>0.55 0.43 0.30 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- HOUSE OUTER WALLS                                          -->
    <!-- House: X = -6 ... +6, Y = -4 ... +4                     -->
    <!-- ========================================================= -->

    <!-- WEST WALL -->
    <model name="west_wall">
      <static>true</static>
      <pose>-6 0 1.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 8 2.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 8 2.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.78 0.76 0.70 1</ambient>
            <diffuse>0.78 0.76 0.70 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


