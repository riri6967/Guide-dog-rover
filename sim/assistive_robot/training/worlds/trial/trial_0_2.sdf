      <link name="link">
        <collision name="collision"><geometry><box><size>0.601 0.570 1.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.601 0.570 1.000</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
