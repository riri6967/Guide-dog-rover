<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="train_world">

    <gravity>0 0 -9.81</gravity>
    <physics name="train" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <!-- ========================================================= -->
    <!-- SYSTEMS                                                    -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>


    <!-- ========================================================= -->
    <!-- LIGHTING                                                    -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">
      <pose>0 0 10 0.4 -0.5 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <light name="room_light_1" type="point">
      <pose>-5 4.5 3.0 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.05</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="room_light_2" type="point">
      <pose>5 -4.5 3.0 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.05</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>


    <!-- ========================================================= -->
    <!-- FLOOR                                                       -->
    <!-- ========================================================= -->

    <model name="floor">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>24 16 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>24 16 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    
    <model name="obj_0">
      <static>true</static>
      <pose>0.000 4.824 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.797 0.200 2.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.797 0.200 2.000</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obj_1">
      <static>true</static>
      <pose>0.000 -4.824 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.797 0.200 2.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.797 0.200 2.000</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obj_2">
      <static>true</static>
      <pose>4.798 0.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.200 9.647 2.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.200 9.647 2.000</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obj_3">
      <static>true</static>
      <pose>-4.798 0.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.200 9.647 2.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.200 9.647 2.000</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obj_4">
      <static>true</static>
      <pose>-2.259 2.188 0.721 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.199</radius><length>1.442</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.199</radius><length>1.442</length></cylinder></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obj_5">
      <static>true</static>
      <pose>-2.559 -1.092 0.730 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.044</radius><length>1.460</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.044</radius><length>1.460</length></cylinder></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obj_6">
      <static>true</static>
      <pose>0.734 1.368 0.778 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.875 0.402 1.556</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.875 0.402 1.556</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <include>
      <uri>model://assistive_rover_train</uri>
      <name>assistive_rover</name>
      <pose>-2.55 -0.05 0 0 0 0</pose>
    </include>
  </world>
</sdf>
