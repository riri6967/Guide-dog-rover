    <!-- ========================================================= -->
    <!-- FURNITURE - ROOM 1                                         -->
    <!-- ========================================================= -->

    <model name="bed_room1">
      <static>true</static>
      <pose>-7.3 5.5 0.35 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.8 1.5 0.7</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.8 1.5 0.7</size>
            </box>
          </geometry>

          <material>
            <diffuse>0.35 0.25 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="table_room1">
      <static>true</static>
      <pose>-3.0 4.0 0.45 0 0 0</pose>

      <link name="link">
        <collision name="collision">
