        <visual name="visual">
          <geometry>
            <box>
              <size>8 0.20 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="room1_front_left_wall">
      <static>true</static>
      <pose>-7.5 1.5 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3 0.20 3</size>
            </box>
