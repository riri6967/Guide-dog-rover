<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="assistive_world">

    <gravity>0 0 -9.81</gravity>

    <physics name="train" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0.0</real_time_factor>
    </physics>

    <!-- ========================================================= -->
    <!-- SYSTEMS                                                    -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>


    <!-- ========================================================= -->
    <!-- LIGHTING                                                    -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">
      <pose>0 0 10 0.4 -0.5 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <light name="room_light_1" type="point">
      <pose>-5 4.5 3.0 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.05</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="room_light_2" type="point">
      <pose>5 -4.5 3.0 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.05</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>


    <!-- ========================================================= -->
    <!-- FLOOR                                                       -->
    <!-- ========================================================= -->

    <model name="floor">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>24 16 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>24 16 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- OUTER WALLS                                                 -->
    <!-- ========================================================= -->

    <model name="outer_wall_left">
      <static>true</static>
      <pose>-12 0 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 16 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 16 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="outer_wall_right">
      <static>true</static>
      <pose>12 0 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 16 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 16 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="outer_wall_top">
      <static>true</static>
      <pose>0 8 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>24 0.20 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>24 0.20 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="outer_wall_bottom">
      <static>true</static>
      <pose>0 -8 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>24 0.20 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>24 0.20 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ========================================================= -->
    <!-- MAIN CORRIDOR WALLS                                        -->
    <!-- ========================================================= -->

    <!-- TOP corridor wall, room opening at x=-5 -->
    <model name="corridor_top_left">
      <static>true</static>
      <pose>-8 1.5 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.20 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.20 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="corridor_top_right">
      <static>true</static>
      <pose>5.3 1.5 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.4 0.20 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>9.4 0.20 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- BOTTOM corridor wall, room opening at x=5 -->
    <model name="corridor_bottom_left">
      <static>true</static>
      <pose>-5 -1.5 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.20 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.20 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="corridor_bottom_right">
      <static>true</static>
      <pose>8 -1.5 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.20 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.20 3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ========================================================= -->
    <!-- ROOM 1 - TOP                                                -->
    <!-- ========================================================= -->

    <model name="room1_left_wall">
      <static>true</static>
      <pose>-9 4.75 1.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 6.50 3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
